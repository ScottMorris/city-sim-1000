{
  "name": "city-sim-1000-workspace",
  "private": true,
  "workspaces": ["app", "crates/tauri-plugin-city-sim", "scripts/city-sim-mcp"],
  "scripts": {
    "dev":                   "cd app && bun run dev",
    "mcp":                   "bun run --cwd scripts/city-sim-mcp start",
    "build":                 "cd app && bun run build",
    "preview":               "cd app && bun run preview",
    "lint":                  "cd app && bun run lint",
    "test":                  "cd app && bun run test",
    "test:ci":               "cd app && bun run test:ci",
    "test:e2e":              "cd app && bun run test:e2e",
    "test:visual":           "cd app && bun run test:visual",
    "test:visual:update":    "cd app && bun run test:visual:update",
    "test:soak":             "cargo test -p city-sim-core --test soak -- --nocapture",
    "test:soak:long":        "SOAK=long cargo test -p city-sim-core --test soak -- --nocapture",
    "build:favicon":         "cd app && bun run build:favicon",
    "build:radio-playlist":  "cd app && bun run build:radio-playlist",
    "build:wasm":            "wasm-pack build crates/city-sim-wasm --target web --out-dir ../../app/src/wasm/sim_wasm",
    "build:plugin-js":       "cd crates/tauri-plugin-city-sim && bun install && bun run build",
    "release:version:check": "./scripts/check-release-versions.sh"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  }
}
