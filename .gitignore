# Node / Vite
app/node_modules
app/dist
/dist
node_modules

# macOS
.DS_Store

# Logs
*.log

# Rust build output
/target
crates/*/target

# wasm-pack output (generated — run `bun run build:wasm` to regenerate)
pkg/
app/src/wasm/

# Playwright MCP session artifacts (screenshots, console logs, page snapshots)
.playwright-mcp/

# cargo-mutants run output and the diff the CI job feeds it (config is .cargo/mutants.toml)
mutants.out/
mutants.out.old/
mutants.diff

# Playwright/vitest test output (app/test-results/junit.xml is a CI artefact, not a commit)
app/test-results/
app/playwright-report/
app/blob-report/

# Local agent config — machine-specific, never shared. `.claude/mcp.json` hard-codes
# an absolute `cwd`, so committing it breaks every other clone and every worktree.
.claude/mcp.json
.claude/settings.local.json

# Ad-hoc screenshots taken while working (hud-*.png, ribbon*.png, city-sim-*.png, …).
# Committed game art lives under app/public/assets/ and studio/, never at the root.
/*.png

# Scratch output and prototypes from the house/asset studio experiments.
# The maintained pipeline is tools/house-studio/, not these.
/house-studio-out/
/app/scripts/house-studio/
